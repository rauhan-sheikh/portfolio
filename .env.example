# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://myuser:mypassword@localhost:5432/portfolio?schema=public"

# ---------------------------------------------------------------------------
# Admin auth
# ---------------------------------------------------------------------------
# REQUIRED in production - the app refuses to boot without it.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET="your-32-character-secret-key-goes-here"

# Only read by prisma/seed.ts when creating the initial admin user.
ADMIN_DEFAULT_PASSWORD="change-this-in-production"

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Used to build absolute URLs inside outgoing emails (confirm / unsubscribe links).
NEXT_PUBLIC_SITE_URL="https://rauhansheikh.com"

# Google Search Console verification token (read by app/layout.tsx).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""

# ---------------------------------------------------------------------------
# Email (Resend)
# ---------------------------------------------------------------------------
# Leave RESEND_API_KEY unset to disable email entirely. The app still works:
# contact messages are persisted and sends are skipped with a console warning.
# NEVER prefix this with NEXT_PUBLIC_ - that would inline it into the client bundle.
RESEND_API_KEY=""

# Must be on a domain verified in Resend. For local testing before your domain
# verifies, use "Portfolio Dev <onboarding@resend.dev>" - the sandbox sender can
# ONLY deliver to the email address that owns your Resend account.
EMAIL_FROM="Rauhan Sheikh <hello@send.rauhansheikh.com>"

# Where replies to the auto-acknowledgement land.
EMAIL_REPLY_TO="hello@rauhansheikh.com"

# Your inbox - where contact form notifications are delivered.
CONTACT_NOTIFY_TO="hello@rauhansheikh.com"

# Separate sending identity for the newsletter, so a newsletter unsubscribe
# does not suppress transactional mail.
NEWSLETTER_FROM="Rauhan Sheikh <writing@send.rauhansheikh.com>"

# Set to 0 to stop sending the auto-acknowledgement to people who contact you
# (halves the per-submission quota cost).
CONTACT_AUTO_ACK="1"
